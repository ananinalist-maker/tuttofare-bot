# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram chat id, куда падают заявки.
# Узнать: напиши боту /id — он ответит твой id.
# Можно указать несколько через запятую: 111111111,222222222
ADMIN_CHAT_ID=111111111

# Путь к файлу базы. На Railway укажи путь внутри примонтированного Volume,
# иначе база будет стираться при каждом редеплое.
DB_PATH=leads.db
